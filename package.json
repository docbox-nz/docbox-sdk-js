{
  "name": "@docbox-nz/docbox-sdk",
  "version": "0.11.1",
  "description": "Docbox client SDK",
  "license": "MIT",
  "author": "Jacobtread",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/docbox-nz/docbox-sdk-js.git"
  },
  "type": "module",
  "main": "./dist/index.browser.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "default": "./dist/index.d.ts"
      },
      "browser": {
        "require": "./dist/index.browser.cjs",
        "default": "./dist/index.browser.esm.js"
      },
      "default": {
        "require": "./dist/index.node.cjs",
        "default": "./dist/index.node.esm.js"
      }
    }
  },
  "scripts": {
    "build": "rolldown -c",
    "prepublishOnly": "npm run build",
    "watch": "rolldown -c --watch",
    "fmt": "oxfmt",
    "lint": "oxlint"
  },
  "dependencies": {
    "formdata-polyfill": "^4.0.10"
  },
  "devDependencies": {
    "oxfmt": "^0.51.0",
    "oxlint": "^1.94.0",
    "rolldown": "^1.3.3",
    "rolldown-plugin-dts": "^0.27.14"
  },
  "peerDependencies": {
    "axios": ">=1.0.0 <2.0.0"
  },
  "packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8"
}
